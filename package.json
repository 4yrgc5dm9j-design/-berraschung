{
  "name": "dailybase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
