# Kopiere diese Datei nach .env und trage optionale Schlüssel ein.
# Die Datei .env wird nicht eingecheckt und nie an den Browser ausgeliefert.

# Port des Dailybase-Servers
PORT=8787

# Optional: Börsenkurse über Finnhub (kostenloser Plan mit Registrierung, v. a. US-Werte)
# https://finnhub.io/register
FINNHUB_API_KEY=
